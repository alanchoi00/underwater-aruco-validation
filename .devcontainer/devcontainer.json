{
  // Builds from the root Dockerfile so the editor resolves against the same pinned
  // versions the analysis runs on. No ROS: extract_bags.py and record_bag.sh need it,
  // but the ROS image ships cv2 4.6 against this one's pinned 4.10.
  "name": "underwater-aruco-validation",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/work",
  "workspaceMount": "source=${localWorkspaceFolder},target=/work,type=bind",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "njpwerner.autodocstring",
        "timonwong.shellcheck",
        "foxundermoon.shell-format",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "yzhang.markdown-all-in-one",
        "eamodio.gitlens"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        // Pylance does not read the image's PYTHONPATH.
        "python.analysis.extraPaths": ["/work"],
        "python.analysis.typeCheckingMode": "basic",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": ["analysis/tests"],
        "python.terminal.activateEnvironment": false,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": { "source.organizeImports.ruff": "explicit" }
        },
        "editor.rulers": [90]
      }
    }
  }
}

{
  // Dev environment for analysis/. It BUILDS FROM analysis/Dockerfile rather than
  // carrying its own, deliberately: that Dockerfile is the reproducibility artifact,
  // the thing "generated by uwaruco-analysis@<sha>" in summary.json actually refers to.
  // A parallel dev image would drift from it and quietly invalidate that claim, and
  // nobody would notice until someone asked which environment produced a figure.
  //
  // Why bother at all: the host is Python 3.10 with cv2 4.5.4 while this image is 3.12
  // with cv2 4.10. Pointed at the host interpreter, Pylance marks correct code wrong
  // (cv2.aruco.ArucoDetector, np.trapezoid) and accepts the 4.6 legacy API this repo
  // exists to avoid. Inside the container it resolves against the pinned versions.
  //
  // Does NOT cover Stage 0: analysis/extract_bags.py is the one file that imports ROS
  // and runs in the ROS 2 container. See analysis/README.md.
  "name": "underwater-aruco-validation (analysis)",
  "build": {
    // Context is the repo root because the Dockerfile does COPY analysis/requirements.txt
    "dockerfile": "../analysis/Dockerfile",
    "context": ".."
  },

  // Match the Dockerfile's WORKDIR and PYTHONPATH so `from analysis import geometry`
  // resolves identically in the editor, in pytest, and in the documented docker run.
  "workspaceFolder": "/work",
  "workspaceMount": "source=${localWorkspaceFolder},target=/work,type=bind",

  // reportlab belongs to the collage, not the analysis, and ruff is an editor tool.
  // Installing them here rather than in the Dockerfile keeps both out of the artifact
  // that certifies the detector version, while still letting you regenerate the print
  // target and lint without a manual pip install.
  "postCreateCommand": "pip install --no-cache-dir -r target/requirements.txt ruff",

  "customizations": {
    "vscode": {
      // Scoped to what this repo actually contains: 22 .py, 3 .yaml, 3 .md, 1 .sh,
      // 1 Dockerfile, 1 devcontainer.json. The docking repo's ROS, C++, URDF, CMake
      // and LaTeX extensions are all deliberately absent, because none of those exist
      // here and this container is deliberately ROS-free.
      "extensions": [
        // Python: the reason this devcontainer exists.
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "njpwerner.autodocstring",

        // capture/record_bag.sh. Worth having: shellcheck is not on the host, so that
        // script has only ever been checked with `bash -n`, which catches syntax and
        // nothing else.
        "timonwong.shellcheck",
        "foxundermoon.shell-format",

        // target/*.yaml carry the marker sizes and the recovered board layout; a typo
        // in those silently changes every derived range.
        "redhat.vscode-yaml",

        // analysis/Dockerfile and this file.
        "ms-azuretools.vscode-docker",

        // Docs and general.
        "yzhang.markdown-all-in-one",
        "eamodio.gitlens"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",

        // The image sets PYTHONPATH=/work, but Pylance does not read it. State it, or
        // `from analysis import geometry` resolves at runtime and not in the editor.
        "python.analysis.extraPaths": ["/work"],
        "python.analysis.typeCheckingMode": "basic",

        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": ["analysis/tests"],
        "python.terminal.activateEnvironment": false,

        // ruff.toml is configured so `ruff check .` passes clean; see its header.
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": { "source.organizeImports.ruff": "explicit" }
        },
        "editor.rulers": [90]
      }
    }
  }
}
